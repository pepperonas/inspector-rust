<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated Contents/Info.plist by the Tauri v2 bundler
  (distribute/macos-application-bundle: "create an Info.plist file in the
  src-tauri folder … merged with the values generated by the Tauri CLI").

  LSUIElement = "agent" app: no Dock icon, no launch-time Dock flash — the app
  lives ONLY in the menu bar (the fedora tray icon). This is the macOS-canonical
  declaration for a menu-bar-only app; the runtime set_activation_policy(Accessory)
  in lib.rs stays as a belt-and-braces fallback and to demote back after the
  eyedropper briefly promotes to Regular.

  NSAppleEventsUsageDescription / NSMicrophoneUsageDescription are injected
  post-build by scripts/install-macos.sh (plutil), NOT here — leaving those in
  one place keeps their wording next to the code that explains why.
-->
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
